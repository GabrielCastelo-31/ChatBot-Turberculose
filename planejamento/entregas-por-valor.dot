digraph Entregas {
 graph [rankdir=TB, bgcolor="white", pad="0.3", ranksep=0.45, fontname="DejaVu Sans", label="Chatbot de tuberculose\nEntregas orientadas a valor", labelloc=t, fontsize=20];
 node [shape=box,style="rounded,filled",fillcolor="#eff5f7",color="#c4d2d9",fontcolor="#173c4b",fontname="DejaVu Sans",fontsize=14,margin="0.22,0.18"];
 edge [color="#718691",arrowsize=.8];
 A [label="20/11/2026  Fluxo básico\nAtendimento, dados mínimos e prescrição\nDemonstração com dados fictícios"];
 B [label="04/12/2026  RAG com fontes\nConsulta documental com referências"];
 C [label="11/12/2026  Validações automatizadas\nEsquema, dose e interações aprovadas"];
 D [label="08/01/2027  Condutas e dispensação\nResumo de PRMs e decisão profissional"];
 E [label="22/01/2027  Documentos e orientações\nRevisão e exportação"];
 F [label="29/01/2027  Consolidação transversal\nPrivacidade, auditoria e acessibilidade"];
 G [label="19/02/2027  Entrega prevista\nEstabilização, regressão e homologação"];
 A -> B -> C -> D -> E -> F -> G;
 note [shape=plaintext,style="",label="Marcos previstos, não comprovação de aceite integral.\nControles mínimos transversais desde o início.\nDatas sem desconto de feriados/recesso.",fontsize=11,fontcolor="#374b57"];
 G -> note [style=invis];
}
